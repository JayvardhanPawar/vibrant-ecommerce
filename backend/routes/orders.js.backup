});

// ================= CUSTOMER ORDER DETAILS =================

router.get("/:id", requireCustomer, async (req, res) => {
  const orderId = validId(req.params.id);

  if (!orderId) {
    return res.status(400).json({
      message: "Invalid order ID"
    });
  }

  try {
    const [orders] = await db.query(
      `SELECT id, order_number, shipping_address,
              subtotal, shipping_charge, total_amount,
              shipping_status, order_status,
              payment_method, payment_status,
              quote_response, quote_expires_at,
              packing_started_at, cancellation_reason,
              cancellation_requested_at,
              cancellation_reviewed_at,
              shipped_at, delivered_at, created_at
       FROM orders
       WHERE id = ? AND customer_id = ?
       LIMIT 1`,
      [orderId, req.customerId]
    );

    if (!orders.length) {
      return res.status(404).json({
        message: "Order not found"
      });
    }

    const [items] = await db.query(
      `SELECT product_id, product_name, sku,
              unit_price, quantity, line_total
       FROM order_items
       WHERE order_id = ?`,
      [orderId]
    );

    const [history] = await db.query(
      `SELECT old_status, new_status, changed_by_type,
              note, created_at
       FROM order_status_history
       WHERE order_id = ?
       ORDER BY id ASC`,
      [orderId]
    );

    const [cancellationRequests] = await db.query(
      `SELECT id, reason, request_status, admin_note,
              created_at, reviewed_at
       FROM order_cancellation_requests
       WHERE order_id = ? AND customer_id = ?
       ORDER BY id DESC`,
      [orderId, req.customerId]
    );

    return res.json({
      success: true,
      order: {
        ...orders[0],
        items,
        history,
        cancellation_requests: cancellationRequests
      }
    });

  } catch (error) {
    console.error("Fetch order details error:", error);

    return res.status(500).json({
      message: "Unable to load order details"
    });
  }
});

// ================= CUSTOMER: CANCEL BEFORE PACKING =================

router.post("/:id/cancel", requireCustomer, async (req, res) => {
  const orderId = validId(req.params.id);

  const reason = String(
    req.body.reason || "Customer requested cancellation"
  ).trim().slice(0, 500);

  if (!orderId) {
    return res.status(400).json({
      message: "Invalid order ID"
    });
  }

  let connection;

  try {
    connection = await db.getConnection();
    await connection.beginTransaction();

    const order = await lockOrder(connection, orderId);

    if (
      !order ||
      Number(order.customer_id) !== Number(req.customerId)
    ) {
      await connection.rollback();

      return res.status(404).json({
        message: "Order not found"
      });
    }

    if (order.order_status === "cancelled") {
      await connection.rollback();

      return res.status(409).json({
        message: "This order is already cancelled"
      });
    }

    if (
      ["packing", "ready_to_ship", "shipped", "delivered"]
        .includes(order.order_status) ||
      order.packing_started_at
    ) {
      await connection.rollback();

      return res.status(409).json({
        message: "Direct cancellation is unavailable after packing starts. Please submit a cancellation request."
      });
    }

    const oldStatus = order.order_status;

    await restoreOrderStock(connection, orderId);

    await connection.query(
      `UPDATE orders
       SET order_status = 'cancelled',
           cancellation_reason = ?,
           cancellation_requested_at = NOW(),
           cancellation_reviewed_at = NOW()
       WHERE id = ?`,
      [reason || "Customer requested cancellation", orderId]
    );

    await connection.query(
      `UPDATE order_shipping_quotes
       SET quote_status = 'superseded'
       WHERE order_id = ? AND quote_status = 'sent'`,
      [orderId]
    );

    await addStatusHistory(
      connection,
      orderId,
      oldStatus,
      "cancelled",
      "customer",
      req.customerId,
      reason
    );

    await connection.commit();

    return res.json({
      success: true,
      message: "Your order has been cancelled."
    });

  } catch (error) {
    if (connection) await connection.rollback();

    console.error("Customer cancel order error:", error);

    return res.status(500).json({
      message: "Unable to cancel this order"
    });

  } finally {
    if (connection) connection.release();
  }
});

// ================= CUSTOMER: REQUEST CANCELLATION AFTER PACKING =================

router.post("/:id/cancellation-request", requireCustomer, async (req, res) => {
  const orderId = validId(req.params.id);
  const reason = String(req.body.reason || "").trim().slice(0, 500);

  if (!orderId) {
    return res.status(400).json({
      message: "Invalid order ID"
    });
  }

  if (!reason) {
    return res.status(400).json({
      message: "Please provide a cancellation reason"
    });
  }

  let connection;

  try {
    connection = await db.getConnection();
    await connection.beginTransaction();

    const order = await lockOrder(connection, orderId);

    if (
      !order ||
      Number(order.customer_id) !== Number(req.customerId)
    ) {
      await connection.rollback();

      return res.status(404).json({
        message: "Order not found"
      });
    }

    if (!["packing", "ready_to_ship"].includes(order.order_status)) {
      await connection.rollback();

      return res.status(409).json({
        message: "Cancellation requests are available after packing starts and before shipment."
      });
    }

    const [existing] = await connection.query(
      `SELECT id
       FROM order_cancellation_requests
       WHERE order_id = ?
         AND customer_id = ?
         AND request_status = 'pending'
       LIMIT 1
       FOR UPDATE`,
      [orderId, req.customerId]
    );

    if (existing.length) {
      await connection.rollback();

      return res.status(409).json({
        message: "A cancellation request is already pending for this order"
      });
    }

    const [result] = await connection.query(
      `INSERT INTO order_cancellation_requests
        (order_id, customer_id, reason, request_status)
       VALUES (?, ?, ?, 'pending')`,
      [orderId, req.customerId, reason]
    );

    await connection.query(
      `UPDATE orders
       SET cancellation_reason = ?,
           cancellation_requested_at = NOW()
       WHERE id = ?`,
      [reason, orderId]
    );

    await addStatusHistory(
      connection,
      orderId,
      order.order_status,
      order.order_status,
      "customer",
      req.customerId,
      "Cancellation requested: " + reason
    );

    await connection.commit();

    return res.status(201).json({
      success: true,
      request_id: result.insertId,
      message: "Your cancellation request has been sent to our team for review."
    });

  } catch (error) {
    if (connection) await connection.rollback();

    console.error("Create cancellation request error:", error);

    return res.status(500).json({
      message: "Unable to submit cancellation request"
    });

  } finally {
    if (connection) connection.release();
  }
});




// ================= ADMIN AUTHENTICATION =================

function requireAdmin(req, res, next) {
  const authorization = req.headers.authorization;

  const bearerToken = authorization?.startsWith("Bearer ")
    ? authorization.slice(7)
    : null;

  const cookiePart = (req.headers.cookie || "")
    .split(";")
    .map((part) => part.trim())
    .find((part) => part.startsWith("admin_session="));

  let cookieToken = null;

  try {
    cookieToken = cookiePart
      ? decodeURIComponent(
          cookiePart.slice("admin_session=".length)
        )
      : null;
  } catch {
    return res.status(401).json({
      message: "Invalid admin session cookie"
    });
  }

  const token = cookieToken || bearerToken;

  if (!token) {
    return res.status(401).json({
      message: "Admin authentication required"
    });
  }

  try {
    const decoded = jwt.verify(
      token,
      process.env.JWT_SECRET
    );

    if (!decoded.id || !decoded.username) {
      return res.status(401).json({
        message: "Invalid admin session"
      });
    }

    req.admin = decoded;
    next();

  } catch {
    return res.status(401).json({
      message: "Invalid or expired admin session"
    });
  }
}

// ================= ADMIN: VIEW ALL ORDERS =================

router.get("/admin/all", requireAdmin, async (req, res) => {
  try {
    const [orders] = await db.query(
      `SELECT o.id, o.order_number, o.customer_id, o.address_id,
              o.subtotal, o.shipping_charge, o.total_amount,
              o.shipping_status, o.order_status,
              o.payment_method, o.payment_status,
              o.quote_response, o.quote_expires_at,
              o.packing_started_at, o.cancellation_requested_at,
              o.created_at,
              c.full_name AS customer_name,
              c.email AS customer_email,
              c.mobile AS customer_mobile,
              (SELECT COUNT(*)
               FROM order_cancellation_requests cr
               WHERE cr.order_id = o.id
                 AND cr.request_status = 'pending')
                 AS pending_cancellation_requests
       FROM orders o
       LEFT JOIN customers c ON c.id = o.customer_id
       ORDER BY o.id DESC`
    );

    return res.json({
      success: true,
      orders
    });

  } catch (error) {
    console.error("Admin list orders error:", error);

    return res.status(500).json({
      message: "Unable to load orders"
    });
  }
});

// ================= ADMIN: ORDER DETAILS =================

router.get("/admin/:id", requireAdmin, async (req, res) => {
  const orderId = validId(req.params.id);

  if (!orderId) {
    return res.status(400).json({
      message: "Invalid order ID"
    });
  }

  try {
    const [rows] = await db.query(
      `SELECT o.*, c.full_name AS customer_name,
              c.email AS customer_email,
              c.mobile AS customer_mobile
       FROM orders o
       LEFT JOIN customers c ON c.id = o.customer_id
       WHERE o.id = ?
       LIMIT 1`,
      [orderId]
    );

    if (!rows.length) {
      return res.status(404).json({
        message: "Order not found"
      });
    }

    const [items] = await db.query(
      `SELECT product_id, product_name, sku,
              unit_price, quantity, line_total
       FROM order_items
       WHERE order_id = ?
       ORDER BY id`,
      [orderId]
    );

    const [quotes] = await db.query(
      `SELECT id, shipping_charge, subtotal, total_amount,
              quote_status, expires_at, responded_at, created_at
       FROM order_shipping_quotes
       WHERE order_id = ?
       ORDER BY id DESC`,
      [orderId]
    );

    const [history] = await db.query(
      `SELECT old_status, new_status, changed_by_type,
              changed_by, note, created_at
       FROM order_status_history
       WHERE order_id = ?
       ORDER BY id ASC`,
      [orderId]
    );

    const [cancellationRequests] = await connectionQueryCancellation(orderId);

    return res.json({
      success: true,
      order: {
        ...rows[0],
        items,
        quotes,
        history,
        cancellation_requests: cancellationRequests
      }
    });

  } catch (error) {
    console.error("Admin order detail error:", error);

    return res.status(500).json({
      message: "Unable to load order details"
    });
  }
});

// Helper to retrieve cancellation requests using the shared pool.
async function connectionQueryCancellation(orderId) {
  return db.query(
    `SELECT id, customer_id, reason, request_status,
            admin_note, reviewed_by, reviewed_at, created_at
     FROM order_cancellation_requests
     WHERE order_id = ?
     ORDER BY id DESC`,
    [orderId]
  );
}

// ================= ADMIN: SAVE SHIPPING QUOTE =================

router.patch("/admin/:id/quote", requireAdmin, async (req, res) => {
  const orderId = validId(req.params.id);
  const shipping = Number(req.body.shipping_charge);

  if (!orderId) {
    return res.status(400).json({
      message: "Invalid order ID"
    });
  }

  if (
    !Number.isFinite(shipping) ||
    shipping < 0 ||
    shipping > 1000000
  ) {
    return res.status(400).json({
      message: "Enter a valid shipping charge"
    });
  }

  let connection;

  try {
    connection = await db.getConnection();
    await connection.beginTransaction();

    const order = await lockOrder(connection, orderId);

    if (!order) {
      await connection.rollback();

      return res.status(404).json({
        message: "Order not found"
      });
    }

    if (
      [
        "cancelled",
        "delivered",
        "shipped",
        "ready_to_ship",
        "packing"
      ].includes(order.order_status)
    ) {
      await connection.rollback();

      return res.status(409).json({
        message: "Shipping quote cannot be changed at this order stage"
      });
    }

    const total = Number(
      (Number(order.subtotal) + shipping).toFixed(2)
    );

    // Invalidate the previous outstanding quote.
    await connection.query(
      `UPDATE order_shipping_quotes
       SET quote_status = 'superseded'
       WHERE order_id = ? AND quote_status = 'sent'`,
      [orderId]
    );

    const [quoteResult] = await connection.query(
      `INSERT INTO order_shipping_quotes
        (order_id, shipping_charge, subtotal, total_amount,
         quote_status, expires_at)
       VALUES (?, ?, ?, ?, 'sent',
               DATE_ADD(NOW(), INTERVAL 48 HOUR))`,
      [
        orderId,
        shipping,
        Number(order.subtotal),
        total
      ]
    );

    const oldStatus = order.order_status;

    await connection.query(
      `UPDATE orders
       SET shipping_charge = ?,
           total_amount = ?,
           shipping_status = 'quoted',
           quote_response = 'pending',
           order_status = 'awaiting_customer_approval',
           quote_expires_at = DATE_ADD(NOW(), INTERVAL 48 HOUR)
       WHERE id = ?`,
      [shipping, total, orderId]
    );

    await connection.query(
      `UPDATE payments
       SET amount = ?
       WHERE order_id = ?
         AND payment_status = 'pending'`,
      [total, orderId]
    );

    await addStatusHistory(
      connection,
      orderId,
      oldStatus,
      "awaiting_customer_approval",
      "admin",
      req.admin.id,
      `Shipping quote #${quoteResult.insertId} sent. Expires in 48 hours.`
    );

    await connection.commit();

    return res.json({
      success: true,
      message: "Shipping quote saved and sent for customer approval. It expires in 48 hours.",
      quote_id: quoteResult.insertId,
      shipping_charge: shipping,
      total_amount: total
    });

  } catch (error) {
    if (connection) await connection.rollback();

    console.error("Save shipping quote error:", error);

    return res.status(500).json({
      message: "Unable to save shipping quote"
    });

  } finally {
    if (connection) connection.release();
  }
});




// ================= ADMIN: UPDATE ORDER STATUS =================

router.patch("/admin/:id/status", requireAdmin, async (req, res) => {
  const orderId = validId(req.params.id);
  const status = String(req.body.order_status || "");
  const trackingNumber = String(
    req.body.tracking_number || ""
  ).trim().slice(0, 150);

  const transitions = {
    confirmed: [
      "pending_confirmation",
      "pending_review"
    ],
    processing: ["confirmed"],
    packing: ["processing"],
    ready_to_ship: ["packing"],
    shipped: ["ready_to_ship"],
    delivered: ["shipped"]
  };

  const allowedStatuses = [
    ...Object.keys(transitions),
    "cancelled"
  ];

  if (!orderId) {
    return res.status(400).json({
      message: "Invalid order ID"
    });
  }

  if (!allowedStatuses.includes(status)) {
    return res.status(400).json({
      message: "Invalid order status"
    });
  }

  let connection;

  try {
    connection = await db.getConnection();
    await connection.beginTransaction();

    const order = await lockOrder(connection, orderId);

    if (!order) {
      await connection.rollback();

      return res.status(404).json({
        message: "Order not found"
      });
    }

    if (
      order.order_status === "cancelled" ||
      order.order_status === "delivered"
    ) {
      await connection.rollback();

      return res.status(409).json({
        message: "This order is already in a final state"
      });
    }

    const oldStatus = order.order_status;

    if (status === "cancelled") {
      await restoreOrderStock(connection, orderId);

      await connection.query(
        `UPDATE orders
         SET order_status = 'cancelled',
             cancellation_reviewed_at = NOW(),
             cancellation_reviewed_by = ?,
             cancellation_reason = COALESCE(
               cancellation_reason,
               'Cancelled by administrator'
             )
         WHERE id = ?`,
        [req.admin.id, orderId]
      );

      await connection.query(
        `UPDATE order_cancellation_requests
         SET request_status = 'approved',
             reviewed_by = ?,
             reviewed_at = NOW(),
             admin_note = COALESCE(
               admin_note,
               'Approved by administrator'
             )
         WHERE order_id = ?
           AND request_status = 'pending'`,
        [req.admin.id, orderId]
      );

      await addStatusHistory(
        connection,
        orderId,
        oldStatus,
        "cancelled",
        "admin",
        req.admin.id,
        "Order cancelled by administrator"
      );

    } else {
      const allowedPrevious = transitions[status];

      if (!allowedPrevious.includes(oldStatus)) {
        await connection.rollback();

        return res.status(409).json({
          message: `Cannot move order from '${oldStatus}' to '${status}'. Follow the order workflow.`
        });
      }

      if (
        status !== "confirmed" &&
        order.quote_response !== "approved"
      ) {
        await connection.rollback();

        return res.status(409).json({
          message: "Customer must approve the shipping quote before fulfilment."
        });
      }

      if (
        status === "confirmed" &&
        order.payment_method === "razorpay" &&
        order.payment_status !== "paid"
      ) {
        await connection.rollback();

        return res.status(409).json({
          message: "Online payment must be completed before confirming this order."
        });
      }

      if (status === "packing") {
        await connection.query(
          `UPDATE orders
           SET packing_started_at = NOW()
           WHERE id = ?`,
          [orderId]
        );
      }

      if (status === "shipped") {
        await connection.query(
          `UPDATE orders
           SET shipped_at = NOW(),
               shipping_status = 'shipped'
           WHERE id = ?`,
          [orderId]
        );
      }

      if (status === "ready_to_ship") {
        await connection.query(
          `UPDATE orders
           SET shipping_status = 'ready_to_ship'
           WHERE id = ?`,
          [orderId]
        );
      }

      if (status === "delivered") {
        await connection.query(
          `UPDATE orders
           SET delivered_at = NOW(),
               shipping_status = 'delivered'
           WHERE id = ?`,
          [orderId]
        );
      }

      await connection.query(
        `UPDATE orders
         SET order_status = ?
         WHERE id = ?`,
        [status, orderId]
      );

      await addStatusHistory(
        connection,
        orderId,
        oldStatus,
        status,
        "admin",
        req.admin.id,
        trackingNumber
          ? `Status updated. Tracking: ${trackingNumber}`
          : "Order status updated by administrator"
      );
    }

    await connection.commit();

    return res.json({
      success: true,
      message: "Order status updated",
      order_status: status
    });

  } catch (error) {
    if (connection) await connection.rollback();

    console.error("Update order status error:", error);

    return res.status(500).json({
      message: "Unable to update order status"
    });

  } finally {
    if (connection) connection.release();
  }
});

// ================= ADMIN: REVIEW CANCELLATION REQUEST =================

router.patch("/admin/:id/cancellation", requireAdmin, async (req, res) => {
  const orderId = validId(req.params.id);
  const requestId = validId(req.body.request_id);
  const action = String(req.body.action || "").toLowerCase();

  const adminNote = String(
    req.body.admin_note || ""
  ).trim().slice(0, 1000) || null;

  if (!orderId) {
    return res.status(400).json({
      message: "Invalid order ID"
    });
  }

  if (!["approved", "rejected"].includes(action)) {
    return res.status(400).json({
      message: "Action must be approved or rejected"
    });
  }

  let connection;

  try {
    connection = await db.getConnection();
    await connection.beginTransaction();

    const order = await lockOrder(connection, orderId);

    if (!order) {
      await connection.rollback();

      return res.status(404).json({
        message: "Order not found"
      });
    }

    const requestSql = requestId
      ? `SELECT *
         FROM order_cancellation_requests
         WHERE id = ?
           AND order_id = ?
           AND request_status = 'pending'
         FOR UPDATE`
      : `SELECT *
         FROM order_cancellation_requests
         WHERE order_id = ?
           AND request_status = 'pending'
         ORDER BY id DESC
         LIMIT 1
         FOR UPDATE`;

    const requestParams = requestId
      ? [requestId, orderId]
      : [orderId];

    const [requests] = await connection.query(
      requestSql,
      requestParams
    );

    if (!requests.length) {
      await connection.rollback();

      return res.status(404).json({
        message: "Pending cancellation request not found"
      });
    }

    const cancellation = requests[0];

    if (action === "approved") {
      if (
        ["shipped", "delivered", "cancelled"]
          .includes(order.order_status)
      ) {
        await connection.rollback();

        return res.status(409).json({
          message: "This order can no longer be cancelled through this request"
        });
      }

      await restoreOrderStock(connection, orderId);

      await connection.query(
        `UPDATE orders
         SET order_status = 'cancelled',
             cancellation_reviewed_at = NOW(),
             cancellation_reviewed_by = ?,
             cancellation_reason = ?
         WHERE id = ?`,
        [
          req.admin.id,
          cancellation.reason,
          orderId
        ]
      );

      await connection.query(
        `UPDATE order_cancellation_requests
         SET request_status = 'approved',
             admin_note = ?,
             reviewed_by = ?,
             reviewed_at = NOW()
         WHERE id = ?`,
        [
          adminNote,
          req.admin.id,
          cancellation.id
        ]
      );

      await addStatusHistory(
        connection,
        orderId,
        order.order_status,
        "cancelled",
        "admin",
        req.admin.id,
        "Cancellation request approved"
      );

    } else {
      await connection.query(
        `UPDATE order_cancellation_requests
         SET request_status = 'rejected',
             admin_note = ?,
             reviewed_by = ?,
             reviewed_at = NOW()
         WHERE id = ?`,
        [
          adminNote,
          req.admin.id,
          cancellation.id
        ]
      );

      await connection.query(
        `UPDATE orders
         SET cancellation_reviewed_at = NOW(),
             cancellation_reviewed_by = ?
         WHERE id = ?`,
        [req.admin.id, orderId]
      );

      await addStatusHistory(
        connection,
        orderId,
        order.order_status,
        order.order_status,
        "admin",
        req.admin.id,
        "Cancellation request rejected"
      );
    }

    await connection.commit();

    return res.json({
      success: true,
      message: action === "approved"
        ? "Cancellation approved. Order cancelled."
        : "Cancellation request rejected.",
      request_status: action
    });

  } catch (error) {
    if (connection) await connection.rollback();

    console.error("Review cancellation request error:", error);

    return res.status(500).json({
      message: "Unable to review cancellation request"
    });

  } finally {
    if (connection) connection.release();
  }
});

// ================= CUSTOMER: SHIPPING QUOTE RESPONSE =================

router.post("/:id/quote-response", requireCustomer, async (req, res) => {
  const orderId = validId(req.params.id);
  const response = String(
    req.body.response || ""
  ).toLowerCase();

  if (!orderId) {
    return res.status(400).json({
      message: "Invalid order ID"
    });
  }

  if (!["approved", "rejected"].includes(response)) {
    return res.status(400).json({
      message: "Invalid quote response"
    });
  }

  let connection;

  try {
    connection = await db.getConnection();
    await connection.beginTransaction();

    const order = await lockOrder(connection, orderId);

    if (
      !order ||
      Number(order.customer_id) !== Number(req.customerId)
    ) {
      await connection.rollback();

      return res.status(404).json({
        message: "Order not found"
      });
    }

    if (
      order.shipping_status !== "quoted" ||
      order.order_status !== "awaiting_customer_approval"
    ) {
      await connection.rollback();

      return res.status(409).json({
        message: "Shipping quote is not available for a response"
      });
    }

    if (order.order_status === "cancelled") {
      await connection.rollback();

      return res.status(409).json({
        message: "This order has already been cancelled"
      });
    }

    if (order.quote_response !== "pending") {
      await connection.rollback();

      return res.status(409).json({
        message: "You have already responded to this quote"
      });
    }

    // Check quote expiry using the database clock.
    const [expiryRows] = await connection.query(
      `SELECT
         CASE
           WHEN quote_expires_at IS NOT NULL
            AND quote_expires_at < NOW()
           THEN 1
           ELSE 0
         END AS is_expired
       FROM orders
       WHERE id = ?`,
      [orderId]
    );

    if (Number(expiryRows[0].is_expired) === 1) {
      await connection.query(
        `UPDATE order_shipping_quotes
         SET quote_status = 'expired'
         WHERE order_id = ?
           AND quote_status = 'sent'`,
        [orderId]
      );

      await restoreOrderStock(connection, orderId);

      await connection.query(
        `UPDATE orders
         SET order_status = 'cancelled',
             quote_response = 'rejected'
         WHERE id = ?`,
        [orderId]
      );

      await addStatusHistory(
        connection,
        orderId,
        order.order_status,
        "cancelled",
        "system",
        null,
        "Shipping quote expired; order cancelled and reserved stock released"
      );

      await connection.commit();

      return res.status(409).json({
        message: "This shipping quote has expired. The order has been cancelled."
      });
    }

    const oldStatus = order.order_status;

    const nextStatus = response === "approved"
      ? (
          order.payment_method === "cod"
            ? "confirmed"
            : "pending_confirmation"
        )
      : "cancelled";

    if (response === "rejected") {
      await restoreOrderStock(connection, orderId);
    }

    await connection.query(
      `UPDATE orders
       SET quote_response = ?,
           order_status = ?
       WHERE id = ?`,
      [response, nextStatus, orderId]
    );

    await connection.query(
      `UPDATE order_shipping_quotes
       SET quote_status = ?,
           responded_at = NOW()
       WHERE order_id = ?
         AND quote_status = 'sent'`,
      [
        response === "approved" ? "accepted" : "rejected",
        orderId
      ]
    );

    await addStatusHistory(
      connection,
      orderId,
      oldStatus,
      nextStatus,
      "customer",
      req.customerId,
      response === "approved"
        ? "Customer approved shipping quote"
        : "Customer rejected shipping quote"
    );

    await connection.commit();

    return res.json({
      success: true,
      message: response === "approved"
        ? (
            order.payment_method === "cod"
              ? "Quote approved. Your COD order is confirmed."
              : "Quote approved. Online payment must be completed before confirmation."
          )
        : "Shipping quote rejected. Your order has been cancelled."
    });

  } catch (error) {
    if (connection) await connection.rollback();

    console.error("Customer quote response error:", error);

    return res.status(500).json({
      message: "Unable to submit your quote response"
    });

  } finally {
    if (connection) connection.release();
  }
});

// ================= EXPORT ROUTER =================

module.exports = router;
